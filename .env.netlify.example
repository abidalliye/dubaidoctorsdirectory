# Set these in Netlify's environment-variable UI for Functions/runtime.
# Use Neon's pooled connection string, including sslmode=require.
DATABASE_URL=postgresql://user:password@your-project-pooler.neon.tech/neondb?sslmode=require
DB_POOL_SIZE=2
# Leave API_URL unset: SSR uses Netlify's deploy-specific URL automatically.
# Leave REDIS_URL and TYPESENSE_API_KEY unset for PostgreSQL-only search.
