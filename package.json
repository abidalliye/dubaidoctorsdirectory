{
  "name": "fertifind",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build:site": "npm run build -w @fertifind/api && node scripts/build-site.mjs",
    "dev:web": "npm run dev -w @fertifind/web",
    "dev:api": "npm run dev -w @fertifind/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "seed": "npm run seed -w @fertifind/api",
    "db:init": "npm run db:init -w @fertifind/api",
    "db:migrate": "npm run db:migrate -w @fertifind/api",
    "package:functions": "npm run build -w @fertifind/api && node scripts/package-functions.mjs",
    "index:search": "npm run index:search -w @fertifind/api",
    "build:release": "npm run build -w @fertifind/api && node scripts/prepare-production.mjs && node scripts/release-schema.mjs && npm run build -w @fertifind/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/plugin-nextjs": "^5.16.2",
    "@netlify/zip-it-and-ship-it": "^16.2.3",
    "netlify-cli": "^27.11.1",
    "prettier": "^3.9.9"
  }
}
